# Supabase (SUPABASE_DB_URL = Postgres connection string, Dashboard -> Connect -> Session pooler)
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Neo4j (the graph loaded by scripts/load_graph_from_supabase.py)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sentinel_corpus2

# Gemini Embedding (must match the ingestion project: gemini-embedding-2, 3072 dims)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2

# LLM (only "gemini" is implemented; LLM_API_KEY falls back to GEMINI_API_KEY when empty)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# JSON list, tried when LLM_MODEL is overloaded
LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite"]

# Application
LOG_LEVEL=INFO
