# Copy this file to .env and fill in YOUR OWN Supabase project values.
# Supabase dashboard -> Project Settings -> API Keys  (and -> Data API for the URL)

# --- Required -----------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (anon) key. Enough to load everything once sql/01_create_tables.sql has run.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional -----------------------------------------------------------------
# Secret (service_role) key. If set, writes use it, so loading still works after
# `python ingest.py lockdown`. Never share it or put it in a notebook.
SUPABASE_SECRET_KEY=

# Postgres connection string (dashboard -> Connect -> Session pooler, port 5432).
# If set, `python ingest.py create / lockdown / reset` run the SQL for you;
# otherwise you paste the files from sql/ into the SQL Editor yourself.
DATABASE_URL=

# Storage bucket for the training files (must match the name in sql/01_create_tables.sql).
SUPABASE_BUCKET=sentinel-data
